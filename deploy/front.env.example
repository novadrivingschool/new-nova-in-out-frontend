# front.env -- variables del front en el servidor (NO subir el real a git).
# El front es estático: las URLs de las APIs van HORNEADAS en la imagen (build-args del workflow),
# no se configuran aquí. Este archivo solo define versión y puerto.
FRONT_IMAGE_TAG=1.0.0
# Puerto del HOST (127.0.0.1) donde nginx llega al front
FRONT_HOST_PORT=5080
