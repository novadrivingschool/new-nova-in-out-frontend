# front.env -- variables del front en el servidor (NO subir el real a git).
# La imagen es la MISMA en dev y prod: las URLs y flags se leen al arrancar el contenedor desde este archivo.
# Sin espacios alrededor del "=" y SIN comentarios en la misma línea del valor.
FRONT_IMAGE_TAG=1.0.0
# Puerto del HOST (127.0.0.1) donde nginx llega al front
FRONT_HOST_PORT=5080

# URLs públicas de las APIs (con https://, sin barra final)
VITE_API_AUTH_URL=https://auth-user.nio.novadrivingone.net
VITE_API_NOVA_IN_OUT_URL=https://api.nio.novadrivingone.net

# Solo true en dev. En prod SIEMPRE false.
VITE_ENABLE_SCREENSHOT_DELETE=false
VITE_DEV_ACTIVITY_BOT=false
